{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/apps/eduos-landing/",
      "permanent": false
    },
    {
      "source": "/apps/edoos-:path*",
      "destination": "/apps/eduos-:path*",
      "permanent": true
    },
    {
      "source": "/atheer",
      "destination": "/apps/eduos-atheer/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/characters/:path*",
      "destination": "https://eduos-core.vercel.app/characters/:path*"
    },
    {
      "source": "/api/atheer/:path*",
      "destination": "https://eduos-core.vercel.app/api/atheer/:path*"
    }
  ],
  "crons": [
    { "path": "/api/cron/weekly-duties", "schedule": "0 14 * * 0" },
    { "path": "/api/cron/daily-substitutions", "schedule": "0 3 * * 1-5" },
    { "path": "/api/cron/weekly-report", "schedule": "0 6 * * 5" },
    { "path": "/api/cron/backup", "schedule": "0 1 */3 * *" }
  ]
}
